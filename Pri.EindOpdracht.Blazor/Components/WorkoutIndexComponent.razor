@inject IWorkoutApiService _workoutService
@inject IWorkoutTypeApiService _typeService
@inject ILocalStorageService _localSotrageService
@inject NavigationManager navigationManager

<div class="col-md-4 mb-3">
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Workout</h5>
            <h6 class="card-subtitle mb-2 text-muted">@Model.Date</h6>
            <p class="card-text">
                <strong>Duration:</strong> @Model.Duration minutes<br />
                <strong>Calories Burned:</strong> @Model.CaloriesBurned<br />
                <strong>User:</strong> @Model.UserName
            </p>
            <button class="btn btn-warning w-100 mb-2" @onclick="ShowUpdate">Update</button>
            <button class="btn btn-danger w-100" @onclick="ShowDelete">Delete</button>
        </div>
    </div>
</div>
@if (isUpdateVisible)
{
    <UpdateWorkoutComponent Model="WorkoutUpdate" Types="Types" OnUpdate="HandleUpdate" OnCancel="HideUpdate" />
}
@if (isDeleteVisible)
{
    <DeleteWorkoutComponent Model="WorkoutUpdate" OnDelete="HandleDelete" OnCancel="HideDelete" />
}
@code {
    [Parameter] public WorkoutResponseDtoModel Model { get; set; }
    [Parameter] public string UserId { get; set; }
    [Parameter] public string UserRole { get; set; }
    public WorkoutTypeResponseDtoModel[] Types { get; set; }
    public WorkoutRequestDtoModel WorkoutUpdate { get; set; }
    private bool isUpdateVisible = false;
    private bool isDeleteVisible = false;

    protected override async Task OnInitializedAsync()
    {
        var token = await _localSotrageService.GetItemAsync<string>("jwtToken");
        Types = await _typeService.GetWorkoutTypesAsync(token);
        var typeId = Types.FirstOrDefault(p => p.Name == Model.WorkoutTypeName).Id;

        WorkoutUpdate = new WorkoutRequestDtoModel
        {
            Id = Model.Id,
            CaloriesBurned = Model.CaloriesBurned,
            Date = Model.Date,
            Duration = Model.Duration,
            
            WorkoutTypeId = typeId

        };

    }

    private void ShowUpdate()
    {
        HideDelete();
        isUpdateVisible = true;

    }

    private void HideUpdate()
    {
        isUpdateVisible = false;
    }

    private void ShowDelete()
    {
        HideUpdate();
        isDeleteVisible = true;

    }

    private void HideDelete()
    {
        isDeleteVisible = false;
    }

    private async Task HandleUpdate()
    {
        var token = await _localSotrageService.GetItemAsync<string>("jwtToken");
        await _workoutService.UpdateWorkoutAsync(WorkoutUpdate, token);
        HideUpdate();
        StateHasChanged();
    }
    private async Task HandleDelete()
    {
        var token = await _localSotrageService.GetItemAsync<string>("jwtToken");
        await _workoutService.DeleteWorkoutAsync(WorkoutUpdate.Id, token);
        HideDelete();
        navigationManager.NavigateTo("/");
    }

}
