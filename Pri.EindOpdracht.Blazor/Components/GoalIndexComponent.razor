@inject IGoalApiService _goalService
@inject ILocalStorageService _localSotrageService
@inject NavigationManager navigationManager

<div class="col-md-4 mb-3">
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Goal</h5>
            <h6 class="card-subtitle mb-2 text-muted">@Model.TargetDate</h6>
            <p class="card-text">
                <strong>Description:</strong> @Model.Description<br />
                <strong>User:</strong> @Model.UserName
            </p>
            <button class="btn btn-warning w-100 mb-2" @onclick="ShowUpdate">Update</button>
            <button class="btn btn-danger w-100" @onclick="ShowDelete">Delete</button>
        </div>
    </div>
</div>
@if (isUpdateVisible)
{
    <UpdateGoalComponent Model="GoalUpdate" OnUpdate="HandleUpdate" OnCancel="HideUpdate" />
}
@if (isDeleteVisible)
{
    <DeleteGoalComponent Model="GoalUpdate" OnDelete="HandleDelete" OnCancel="HideDelete" />
}


@code {
    [Parameter] public GoalResponseDtoModel Model { get; set; }
    [Parameter] public string LoggedInUserId { get; set; }
    [Parameter] public string LoggedInUserRole { get; set; }
    public GoalRequestDtoModel GoalUpdate { get; set; }
    private bool isUpdateVisible = false;
    private bool isDeleteVisible = false;

    protected override async Task OnInitializedAsync()
    {
        var token = await _localSotrageService.GetItemAsync<string>("jwtToken");


        GoalUpdate = new GoalRequestDtoModel
        {
            Id = Model.Id,
            Achieved = Model.Achieved,
            Description = Model.Description,
            TargetDate = Model.TargetDate,
            UserId = Model.UserId
        };

    }

    private void ShowUpdate()
    {
        HideDelete();
        isUpdateVisible = true;

    }

    private void HideUpdate()
    {
        isUpdateVisible = false;
    }

    private void ShowDelete()
    {
        HideUpdate();
        isDeleteVisible = true;

    }

    private void HideDelete()
    {
        isDeleteVisible = false;
    }

    private async Task HandleUpdate()
    {
        var token = await _localSotrageService.GetItemAsync<string>("jwtToken");
        await _goalService.UpdateGoalAsync(GoalUpdate, token);
        HideUpdate();
        StateHasChanged();
    }
    private async Task HandleDelete()
    {
        var token = await _localSotrageService.GetItemAsync<string>("jwtToken");
        await _goalService.DeleteGoalAsync(GoalUpdate.Id, token);
        HideDelete();
        navigationManager.NavigateTo("/");
    }

}
