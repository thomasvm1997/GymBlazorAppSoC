<div class="card">
    <div class="card-header">Update Goal</div>
    <div class="card-body">
        <EditForm Model="Model" OnValidSubmit="HandleUpdate">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label for="Duration" class="form-label">Duration</label>
                <InputNumber id="Duration" class="form-control" @bind-Value="Model.Duration" />
                <ValidationMessage For="@(() => Model.Duration)" />
            </div>

            <div class="mb-3">
                <label for="Calories" class="form-label">Calories Burned</label>
                <InputNumber id="Calories" class="form-control" @bind-Value="Model.CaloriesBurned" />
                <ValidationMessage For="@(() => Model.CaloriesBurned)" />
            </div>

            <div class="mb-3">
                <label for="TargetDate" class="form-label">Diffculty</label>
                <InputDate id="TargetDate" class="form-control" @bind-Value="Model.Date" />
                <ValidationMessage For="@(() => Model.Date)" />
            </div>
            <div class="mb-3">
                <label for="TypeId" class="form-label">Workout Type</label>
                <select id="TypeId" class="form-select" @bind="Model.WorkoutTypeId">
                    <option value="" disabled selected>-- Select Workout Type --</option>
                    @if (Types != null)
                    {
                        @foreach (var type in Types)
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    }
                </select>
                <ValidationMessage For="@(() => Model.WorkoutTypeId)" />
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <button type="button" class="btn btn-secondary" @onclick="HandleCancel">Cancel</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public WorkoutRequestDtoModel Model { get; set; }
    [Parameter] public WorkoutTypeResponseDtoModel[] Types { get; set; }
    [Parameter] public EventCallback OnUpdate { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleUpdate()
    {
        await OnUpdate.InvokeAsync();
    }
    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }
}