@page "/"
@inject IUserApiService _userService
@inject IJwtAuthenticationStateProvider _jwtService
@inject ILocalStorageService _LocalStorageService
@inject IGoalApiService _goalService
@inject IWorkoutApiService _workoutService
@inject IWorkoutTypeApiService _workoutTypeService

<PageTitle>Index</PageTitle>

@if (isUserLoggedIn == false)
{
    <div>
        <h1 style="text-align:center">Workout App</h1>
        @if (counterLogin == 0)
        {

            <LoginComponent LoginModel="LoginModel" OnSubmit="HandleLogin" />
        }
        else if (counterLogin != 0)
        {
            <h4 style="color:red">Failed</h4>
            <LoginComponent LoginModel="LoginModel" OnSubmit="HandleLogin" />
        }
        @if (isRegisterSucces == false && counterRegister == 0)
        {

            <RegisterComponent RegisterModel="RegisterModel" OnSubmit="HandleRegister" />

        }
        else if (isRegisterSucces == false && counterRegister != 0)
        {

            <h4 style="color:red">Failed</h4>
            <RegisterComponent RegisterModel="RegisterModel" OnSubmit="HandleRegister" />

        }
        else if (isRegisterSucces == true)
        {
            <h4>Succes!</h4>
        }
    </div>
}
else
{
    @if (UserRole == "Customer")
    {
        {
            <h3>Customer Dashboard</h3>
            <button class="btn btn-primary" @onclick="FetchWorkouts">Get Workouts</button>
            <button class="btn btn-secondary" @onclick="FetchGoals">Get Goals</button>

            @if (Workouts != null && isWorkoutsVisible == true)
            {
                <h4>Your Workouts</h4>
                <button class="btn btn-secondary" @onclick="ShowWorkoutCreate">Create Workout</button>
                if (IsWorkoutCreateVisible == true)
                {
                    <CreateWorkoutComponent Model="@CreateWorkoutModel" Types="@Types" OnCreate="CreateWorkout" OnCancel="HideWorkoutCreate" />
                }
                <div class="row">
                    @foreach (var workout in Workouts)
                    {
                        <WorkoutIndexComponent Model="workout" LoggedInUserId="@UserId" LoggedInUserRole="@UserRole" />
                    }
                </div>
            }

            @if (Goals != null && isGoalsVisible == true)
            {
                <h4>Your Goals</h4>
                <button class="btn btn-secondary" @onclick="ShowGoalCreate">Create Goal</button>
                if (IsGoalCreateVisible == true)
                {
                    <CreateGoalComponent Model="@CreateGoalModel" OnCreate="CreateGoal" OnCancel="HideGoalCreate" />
                }
                <div class="row">
                    @foreach (var goal in Goals)
                    {
                        <GoalIndexComponent Model="goal" LoggedInUserId="@UserId" LoggedInUserRole="@UserRole" />
                    }
                </div>
            }
        }
    }
    else if (UserRole == "Admin")
    {
        <h3>Admin Dashboard</h3>
        <button class="btn btn-primary" @onclick="FetchWorkouts">Get Workouts</button>
        <button class="btn btn-secondary" @onclick="FetchGoals">Get Goals</button>
        <button class="btn btn-secondary" @onclick="FetchTypes">Get Workout Types</button>

        @if (Workouts != null && isWorkoutsVisible == true)
        {
            <h4>All User Workouts</h4>
            <div class="row">
                @foreach (var workout in Workouts)
                {
                    <WorkoutIndexComponent Model="workout" LoggedInUserId="@UserId" LoggedInUserRole="@UserRole" />
                }
            </div>
        }
        @if (Goals != null && isGoalsVisible == true)
        {
            <h4>All User Goals</h4>
            <div class="row">
                @foreach (var goal in Goals)
                {
                    <GoalIndexComponent Model="goal" LoggedInUserId="@UserId" LoggedInUserRole="@UserRole" />
                }
            </div>
        }
        @if (Types != null && isTypesVisible)
        {
            <h4>All Workout types</h4>
            <button class="btn btn-secondary" @onclick="ShowTypeCreate">Create Type</button>
            if (IsTypeCreateVisible == true)
            {
                <CreateTypeComponent Model="@CreateTypeModel" OnCreate="CreateType" OnCancel="HideTypeCreate" />
            }
            <div class="row">

                @foreach (var type in Types)
                {
                    <TypeIndexComponent Model="type" />
                }
            </div>
        }
    }
}

@code{

    public LoginUserRequestDtoModel LoginModel { get; set; } = new LoginUserRequestDtoModel();
    public RegisterUserRequestDtoModel RegisterModel { get; set; } = new RegisterUserRequestDtoModel();
    public WorkoutResponseDtoModel[] Workouts { get; set; }
    public GoalResponseDtoModel[] Goals { get; set; }
    public WorkoutTypeResponseDtoModel[] Types { get; set; }
    public WorkoutRequestDtoModel CreateWorkoutModel { get; set; }
    public GoalRequestDtoModel CreateGoalModel { get; set; }
    public WorkoutTypeRequestDtoModel CreateTypeModel { get; set; } = new WorkoutTypeRequestDtoModel();
    public string UserRole { get; set; } = "";
    public string UserId { get; set; } = "";
    private bool isWorkoutsVisible;
    private bool isGoalsVisible;
    private bool isTypesVisible;
    private bool IsWorkoutCreateVisible;
    private bool IsGoalCreateVisible;
    private bool IsTypeCreateVisible;
    private bool isUserLoggedIn;
    private bool isRegisterSucces = false;
    private int counterRegister = 0;
    private int counterLogin = 0;


    protected override async Task OnInitializedAsync()
    {
        isUserLoggedIn = false;

    }

    private async Task HandleLogin()
    {
        try
        {
            var result = await _userService.LoginAsync(LoginModel);
            await _LocalStorageService.SetItemAsync("jwtToken", result.Token);
            var user = await _jwtService.GetAuthenticationStateAsync();

            UserRole = user.User.Claims.FirstOrDefault(p => p.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
            UserId = user.User.Claims.FirstOrDefault(p => p.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            isUserLoggedIn = true;
            var token = await _LocalStorageService.GetItemAsync<string>("jwtToken");
            Types = await _workoutTypeService.GetWorkoutTypesAsync(token);

            CreateWorkoutModel = new WorkoutRequestDtoModel { UserId = UserId }; //userid's toekennen voor required field dtomodel
            CreateGoalModel = new GoalRequestDtoModel { UserId = UserId };

        }
        catch (Exception ex)
        {
            counterLogin++;
            Console.WriteLine($"Login failed: {ex.Message}");
        }
    }

    private async Task HandleRegister()
    {
        try
        {

            var result = await _userService.RegisterAsync(RegisterModel);
            isRegisterSucces = result.Success;
        }
        catch (Exception ex)
        {
            counterRegister++;
            isRegisterSucces = false;
            Console.WriteLine($"Registration failed: {ex.Message}");
        }
    }
    private async Task FetchWorkouts()
    {
        try
        {
            var token = await _LocalStorageService.GetItemAsync<string>("jwtToken");
            if (UserRole == "Customer")
            {

                Workouts = await _workoutService.GetWorkoutsByUserIdAsync(UserId, token);
            }
            else if (UserRole == "Admin")
            {
                Workouts = await _workoutService.GetWorkoutsAsync(token);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching workouts: {ex.Message}");
        }
        StateHasChanged();
        isWorkoutsVisible = true;
        isTypesVisible = false;
        isGoalsVisible = false;

    }

    private async Task FetchGoals()
    {
        try
        {
            var token = await _LocalStorageService.GetItemAsync<string>("jwtToken");
            if (UserRole == "Customer")
            {
                Goals = await _goalService.GetGoalsByUserIdAsync(UserId, token);
            }
            else if (UserRole == "Admin")
            {
                Goals = await _goalService.GetGoalsAsync(token);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching goals: {ex.Message}");
        }
        StateHasChanged();
        isWorkoutsVisible = false;
        isTypesVisible = false;
        isGoalsVisible = true;
    }
    private async Task FetchTypes()
    {
        try
        {
            var token = await _LocalStorageService.GetItemAsync<string>("jwtToken");
            Types = await _workoutTypeService.GetWorkoutTypesAsync(token);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching goals: {ex.Message}");
        }
        StateHasChanged();
        isWorkoutsVisible = false;
        isTypesVisible = true;
        isGoalsVisible = false;
    }
    private async Task ShowWorkoutCreate()
    {
        IsWorkoutCreateVisible = true;
    }
    private async Task HideWorkoutCreate()
    {
        IsWorkoutCreateVisible = false;
    }
    private async Task CreateWorkout()
    {
        try
        {

            var token = await _LocalStorageService.GetItemAsync<string>("jwtToken");
            await _workoutService.CreateWorkoutAsync(CreateWorkoutModel, token);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating workout: {ex.Message}");
        }
        HideWorkoutCreate();
        StateHasChanged();
    }
    private async Task ShowGoalCreate()
    {
        IsGoalCreateVisible = true;
    }
    private async Task HideGoalCreate()
    {
        IsGoalCreateVisible = false;
    }
    private async Task CreateGoal()
    {
        try
        {

            var token = await _LocalStorageService.GetItemAsync<string>("jwtToken");
            await _goalService.CreateGoalAsync(CreateGoalModel, token);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating workout: {ex.Message}");
        }
        HideGoalCreate();
        StateHasChanged();
    }
    private async Task ShowTypeCreate()
    {
        IsTypeCreateVisible = true;
    }
    private async Task HideTypeCreate()
    {
        IsTypeCreateVisible = false;
    }
    private async Task CreateType()
    {
        try
        {

            var token = await _LocalStorageService.GetItemAsync<string>("jwtToken");
            await _workoutTypeService.CreateWorkoutTypeAsync(CreateTypeModel, token);

            Types = await _workoutTypeService.GetWorkoutTypesAsync(token);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating workout: {ex.Message}");
        }
        HideTypeCreate();
        StateHasChanged();
    }
}
